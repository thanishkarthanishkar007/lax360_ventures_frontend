# Copy to .env for local development.
# Points the "Book a Demo" form at the backend API.

# The app already defaults to the deployed Render backend below, so this
# file/variable is ONLY needed if you want to override it - most commonly
# for local development against a backend running on your own machine:

VITE_API_BASE_URL=http://localhost:8080

# Production default (no .env needed for this - it's baked into DemoForm.jsx):
# VITE_API_BASE_URL=https://lax360-ventures-backend.onrender.com
